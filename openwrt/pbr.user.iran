#!/bin/sh
# pbr.user.iran - load pre-built Iranian IPv4 prefixes into the pbr user set.
#
# All fetching, parsing, validation, de-duplication and aggregation is done daily by
# https://github.com/Cod3ByAmir/iran-ip-ranges . This script only downloads the ready
# made element lists, verifies their checksums and hands them to nft. It is stateless:
# no cache, no version comparison, every call does the whole job.
#
# Two run modes, detected automatically:
#   pbr mode    - pbr runs this file while building /var/run/pbr.nft. There `nft` is a shell
#                 function that queues commands into that batch, and the sets do not exist in
#                 the kernel yet. We queue one "add element"; pbr installs the batch.
#   direct mode - run by hand or from cron after pbr is up. We check that the set exists and
#                 apply "flush set" + "add element" as one atomic nft transaction.
#
# IPv4 only: IPv6 is disabled on the router and on the WireGuard servers, so the IPv6
# list the repo also publishes is never downloaded.
#
# Logs go to syslog (tag pbr-iran, see `logread -e pbr-iran`) and to stdout, one line per step:
#   pbr-iran  updating Iranian IPv4 set (direct mode)
#     ✓ source   GitHub release, lists built 2026-09-11 23:05 UTC
#     ✓ IPv4     2085 prefixes (34.1 KB, sha256 ok) loaded into pbr_wan_4_dst_ip_user
#   pbr-iran  done in 2s

IR_IFACE='wan'
IR_TABLE='inet fw4'
IR_REPO='Cod3ByAmir/iran-ip-ranges'
IR_BASES="https://github.com/$IR_REPO/releases/latest/download https://raw.githubusercontent.com/$IR_REPO/main/dist"

IR_TMP_DIR='/var/pbr-iran'
IR_FETCH_TIMEOUT=20
IR_MIN_V4=100

IR_BASE=''
IR_SOURCE=''
IR_MODE='direct'
IR_START=$(date +%s)

# console colours only when stdout is a terminal; syslog and pbr output stay plain
if [ -t 1 ]; then
    IR_C_OK='\033[32m' IR_C_WARN='\033[33m' IR_C_ERR='\033[31m' IR_C_DIM='\033[2m' IR_C_BOLD='\033[1m' IR_C_OFF='\033[0m'
else
    IR_C_OK='' IR_C_WARN='' IR_C_ERR='' IR_C_DIM='' IR_C_BOLD='' IR_C_OFF=''
fi

ir_log() {
    # $1 level (ok|info|warn|err|head), $2 step label, $3 message
    # console: "  ✓ IPv4     message"   syslog: "IPv4: message"
    local prio mark colour
    case "$1" in
        ok)   prio='daemon.info';   mark='✓'; colour="$IR_C_OK" ;;
        warn) prio='daemon.warn';   mark='!'; colour="$IR_C_WARN" ;;
        err)  prio='daemon.err';    mark='✗'; colour="$IR_C_ERR" ;;
        head) prio='daemon.notice'; mark='' ;;
        *)    prio='daemon.info';   mark='·'; colour="$IR_C_DIM" ;;
    esac
    if [ "$1" = 'head' ]; then
        logger -t pbr-iran -p "$prio" "$3" 2>/dev/null
        printf "${IR_C_BOLD}pbr-iran${IR_C_OFF}  %s\n" "$3"
        return 0
    fi
    logger -t pbr-iran -p "$prio" "$2: $3" 2>/dev/null
    printf "  ${colour}%s${IR_C_OFF} %-8s %s\n" "$mark" "$2" "$3"
}

ir_human_size() {
    awk -v b="$1" 'BEGIN { if (b >= 1048576) printf "%.1f MB", b/1048576; else if (b >= 1024) printf "%.1f KB", b/1024; else printf "%d B", b }'
}

ir_detect_mode() {
    case "$(type nft 2>/dev/null)" in
        *function*) IR_MODE='pbr' ;;
        *)          IR_MODE='direct' ;;
    esac
}

ir_set_ready() {
    # $1 set name. In pbr mode the set is created later from the batch, so assume it is there.
    [ "$IR_MODE" = 'pbr' ] && return 0
    /usr/sbin/nft list set $IR_TABLE "$1" >/dev/null 2>&1
}

ir_fetch() {
    # $1 url, $2 destination file, $3 step label for the log
    if uclient-fetch -q -T "$IR_FETCH_TIMEOUT" -O "$2" "$1" 2>/dev/null && [ -s "$2" ]; then
        return 0
    fi
    # retry without certificate check (e.g. router clock not set yet); warn only if that is what worked
    if uclient-fetch -q -T "$IR_FETCH_TIMEOUT" --no-check-certificate -O "$2" "$1" 2>/dev/null && [ -s "$2" ]; then
        ir_log warn "$3" "${1##*/} fetched without TLS verification (certificate check failed)"
        return 0
    fi
    return 1
}

ir_source_name() {
    case "$1" in
        */releases/*) echo 'GitHub release' ;;
        *raw.githubusercontent.com*) echo 'raw.githubusercontent.com (main branch)' ;;
        *) echo "$1" ;;
    esac
}

ir_pick_base() {
    # Use the first base that serves the checksum file; every other file comes from the same base.
    local base built
    for base in $IR_BASES; do
        if ir_fetch "$base/sha256sums.txt" "$IR_TMP_DIR/sha256sums.txt" source; then
            IR_BASE="$base"
            IR_SOURCE=$(ir_source_name "$base")
            # build time is informational only; a missing or odd version.txt is not an error
            if uclient-fetch -q -T "$IR_FETCH_TIMEOUT" -O "$IR_TMP_DIR/version.txt" "$base/version.txt" 2>/dev/null \
                || uclient-fetch -q -T "$IR_FETCH_TIMEOUT" --no-check-certificate -O "$IR_TMP_DIR/version.txt" "$base/version.txt" 2>/dev/null; then
                built=$(head -c 20 "$IR_TMP_DIR/version.txt" | sed 's/T/ /; s/:[0-9][0-9]Z$/ UTC/')
            fi
            ir_log ok source "$IR_SOURCE${built:+, lists built $built}"
            return 0
        fi
        ir_log warn source "$(ir_source_name "$base") unreachable"
    done
    return 1
}

ir_load() {
    local file='iran-ipv4.nft' min="$IR_MIN_V4"
    local step='IPv4' set="pbr_${IR_IFACE}_4_dst_ip_user"
    local count size rules

    if ! ir_set_ready "$set"; then
        ir_log err "$step" "set $IR_TABLE $set not found, is pbr running with a policy for $IR_IFACE?"
        return 1
    fi

    if ! ir_fetch "$IR_BASE/$file" "$IR_TMP_DIR/$file" "$step"; then
        ir_log err "$step" "download failed: $file, set left unchanged"
        return 1
    fi
    size=$(ir_human_size "$(wc -c < "$IR_TMP_DIR/$file")")

    if ! ( cd "$IR_TMP_DIR" && grep " $file\$" sha256sums.txt | sha256sum -c -s ); then
        ir_log err "$step" "checksum mismatch for $file, set left unchanged"
        return 1
    fi

    count=$(( $(tr -cd ',' < "$IR_TMP_DIR/$file" | wc -c) + 1 ))
    if [ "$count" -lt "$min" ]; then
        ir_log err "$step" "only $count prefixes in $file (minimum $min), set left unchanged"
        return 1
    fi

    if [ "$IR_MODE" = 'pbr' ]; then
        # queue into pbr's batch; the set is created fresh in the same batch, nothing to flush
        nft "add element $IR_TABLE $set { $(cat "$IR_TMP_DIR/$file") }"
        ir_log ok "$step" "$count prefixes ($size, sha256 ok) queued for $set"
        return 0
    fi

    rules="$IR_TMP_DIR/rules.nft"
    {
        echo "flush set $IR_TABLE $set"
        printf 'add element %s %s { ' "$IR_TABLE" "$set"
        cat "$IR_TMP_DIR/$file"
        echo ' }'
    } > "$rules"

    if /usr/sbin/nft -f "$rules" 2>"$IR_TMP_DIR/nft.err"; then
        ir_log ok "$step" "$count prefixes ($size, sha256 ok) loaded into $set"
        return 0
    fi
    ir_log err "$step" "nft rejected the list for $set, set left unchanged"
    ir_log err "$step" "nft: $(head -c 300 "$IR_TMP_DIR/nft.err" | tr '\n' ' ')"
    return 1
}

ir_main() {
    local elapsed

    ir_detect_mode
    ir_log head '' "updating Iranian IPv4 set ($IR_MODE mode)"
    rm -rf "$IR_TMP_DIR"
    if ! mkdir -p "$IR_TMP_DIR"; then
        ir_log err setup "cannot create $IR_TMP_DIR"
        ir_log head '' 'aborted, set left unchanged'
        return 1
    fi

    if ! ir_pick_base; then
        ir_log err source "no source reachable for sha256sums.txt"
        ir_log head '' 'aborted, set left unchanged'
        rm -rf "$IR_TMP_DIR"
        return 1
    fi

    if ir_load; then
        rm -rf "$IR_TMP_DIR"
        elapsed=$(( $(date +%s) - IR_START ))
        ir_log head '' "done in ${elapsed}s"
        return 0
    fi
    rm -rf "$IR_TMP_DIR"
    ir_log head '' 'failed, set left unchanged'
    return 1
}

ir_main
